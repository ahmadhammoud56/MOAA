{
  "version": "1.3.2",
  "schema": 1,
  "models": {
    "haiku": "claude-haiku-5-5",
    "sonnet": "claude-sonnet-5-5",
    "opus": "claude-opus-5-5",
    "fable": "claude-fable-5-1"
  },
  "effort_levels": ["low", "medium", "high", "xhigh", "max"],
  "policy": {
    "fable": "Highest-consequence judgment: final adjudication, adversarial security, hard-to-reverse architecture, subtle causal identification.",
    "opus": "Deep analytical or verification work where a wrong derivation silently propagates (mechanics, statistics, validation, debugging, contracts).",
    "sonnet": "Production work with observable checks: implementation, pipelines, writing, design, planning.",
    "haiku": "Fast retrieval, scanning, and organization where breadth and speed matter more than deep reasoning.",
    "effort": "low = lookup; medium = routine production; high = analysis with verification; xhigh = adversarial or judging work; max = reserved, only by explicit request."
  },
  "roles": {
    "arbiter": {"tier": "fable", "effort": "xhigh", "why": "Final evaluation and integration; its errors become the deliverable."},
    "architect": {"tier": "fable", "effort": "high", "why": "Decomposition decisions are expensive to reverse."},
    "security-reviewer": {"tier": "fable", "effort": "xhigh", "why": "Adversarial reasoning; one missed path is costly."},
    "causal-inference-analyst": {"tier": "fable", "effort": "high", "why": "Identification arguments fail subtly and look plausible."},
    "challenger": {"tier": "opus", "effort": "xhigh", "why": "Falsification needs depth to find the smallest real counterexample."},
    "analyst": {"tier": "opus", "effort": "high", "why": "Mathematical and statistical derivations."},
    "debugger": {"tier": "opus", "effort": "high", "why": "Root-cause isolation across competing explanations."},
    "constitutive-modeler": {"tier": "opus", "effort": "high", "why": "Material laws and calibration identifiability."},
    "fem-specialist": {"tier": "opus", "effort": "high", "why": "Discretization and convergence errors are silent."},
    "failure-mechanics-specialist": {"tier": "opus", "effort": "high", "why": "Failure modes and load paths are safety relevant."},
    "controls-engineer": {"tier": "opus", "effort": "high", "why": "Stability and estimation analysis."},
    "statistician": {"tier": "opus", "effort": "high", "why": "Inference, sampling units, and effect sizes."},
    "validation-auditor": {"tier": "opus", "effort": "high", "why": "Leakage and generalization claims need careful audit."},
    "uncertainty-analyst": {"tier": "opus", "effort": "high", "why": "Sensitivity and propagation reasoning."},
    "optimization-specialist": {"tier": "opus", "effort": "high", "why": "Formulation and feasibility proofs."},
    "experimental-design-specialist": {"tier": "opus", "effort": "high", "why": "Choosing discriminating experiments under constraints."},
    "peer-reviewer": {"tier": "opus", "effort": "high", "why": "Whether claims survive scrutiny."},
    "interpretability-analyst": {"tier": "opus", "effort": "high", "why": "Model behavior explanations are easy to over-read."},
    "systems-thinker": {"tier": "opus", "effort": "high", "why": "Feedback loops and second-order effects."},
    "decision-analyst": {"tier": "opus", "effort": "high", "why": "Option comparison under stated priorities."},
    "api-designer": {"tier": "opus", "effort": "high", "why": "Public contracts are costly to change."},
    "database-engineer": {"tier": "opus", "effort": "high", "why": "Schemas, transactions, and migrations risk data loss."},
    "reliability-engineer": {"tier": "opus", "effort": "high", "why": "Failure and recovery behavior under degraded conditions."},
    "integration-engineer": {"tier": "sonnet", "effort": "high", "why": "Cross-component contracts; checking assembled behavior is observable work, verified at high effort."},
    "requirements-analyst": {"tier": "sonnet", "effort": "high", "why": "Resolving ambiguity into verifiable scope; checkable output, verified at high effort."},
    "reproducibility-auditor": {"tier": "opus", "effort": "medium", "why": "Tracing raw inputs to results; methodical rather than creative."},
    "materials-specialist": {"tier": "opus", "effort": "medium", "why": "Processing-structure-property reasoning."},
    "rheology-specialist": {"tier": "opus", "effort": "medium", "why": "Flow-curve interpretation and protocol artifacts."},
    "scenario-planner": {"tier": "opus", "effort": "medium", "why": "Robustness across plausible futures."},
    "backend-engineer": {"tier": "sonnet", "effort": "high", "why": "Business logic and state transitions with tests."},
    "ml-engineer": {"tier": "sonnet", "effort": "high", "why": "Training and inference pipelines with baselines."},
    "test-engineer": {"tier": "sonnet", "effort": "high", "why": "Acceptance and regression coverage."},
    "performance-engineer": {"tier": "sonnet", "effort": "high", "why": "Measured bottlenecks, not guesses."},
    "transport-network-analyst": {"tier": "sonnet", "effort": "high", "why": "Graph and assignment semantics."},
    "metrology-specialist": {"tier": "sonnet", "effort": "high", "why": "Error budgets and calibration arithmetic."},
    "scientific-writer": {"tier": "sonnet", "effort": "high", "why": "Claims must match evidence precisely."},
    "builder": {"tier": "sonnet", "effort": "medium", "why": "General implementation with observable checks."},
    "frontend-engineer": {"tier": "sonnet", "effort": "medium", "why": "Client behavior and state."},
    "data-engineer": {"tier": "sonnet", "effort": "medium", "why": "Ingestion and transformations."},
    "refactoring-engineer": {"tier": "sonnet", "effort": "medium", "why": "Behavior-preserving changes guarded by tests."},
    "release-engineer": {"tier": "sonnet", "effort": "medium", "why": "Builds, CI gates, packaging."},
    "retrieval-engineer": {"tier": "sonnet", "effort": "medium", "why": "Indexing and retrieval pipelines."},
    "geospatial-analyst": {"tier": "sonnet", "effort": "medium", "why": "Spatial joins and projections."},
    "additive-manufacturing-specialist": {"tier": "sonnet", "effort": "medium", "why": "Buildability and toolpath checks."},
    "experimentalist": {"tier": "sonnet", "effort": "medium", "why": "Running and documenting methods."},
    "data-quality-auditor": {"tier": "sonnet", "effort": "medium", "why": "Profiling and fitness checks."},
    "editor": {"tier": "sonnet", "effort": "medium", "why": "Prose clarity and synthesis."},
    "designer": {"tier": "sonnet", "effort": "medium", "why": "Interfaces and visuals."},
    "visualization-specialist": {"tier": "sonnet", "effort": "medium", "why": "Charts and figures."},
    "presentation-strategist": {"tier": "sonnet", "effort": "medium", "why": "Narrative and slide structure."},
    "instructional-designer": {"tier": "sonnet", "effort": "medium", "why": "Lesson alignment."},
    "technical-documentarian": {"tier": "sonnet", "effort": "medium", "why": "Guides and runbooks."},
    "literature-reviewer": {"tier": "sonnet", "effort": "medium", "why": "Source gathering and synthesis."},
    "project-planner": {"tier": "sonnet", "effort": "medium", "why": "Sequencing and milestones."},
    "product-strategist": {"tier": "sonnet", "effort": "medium", "why": "Priorities and user value."},
    "process-improvement-analyst": {"tier": "sonnet", "effort": "medium", "why": "Workflow bottlenecks."},
    "cost-analyst": {"tier": "sonnet", "effort": "medium", "why": "Budget arithmetic and tradeoffs."},
    "accessibility-reviewer": {"tier": "sonnet", "effort": "medium", "why": "Standards-based inclusive-use review."},
    "scout": {"tier": "haiku", "effort": "low", "why": "Fast, broad source discovery; lookups, so low effort."},
    "information-architect": {"tier": "sonnet", "effort": "medium", "why": "Organizing and indexing knowledge; structure and navigation need judgment, not just scanning."}
  },
  "personality_effort_shift": {
    "skeptic": 1, "perfectionist": 1, "theorist": 1, "detective": 1, "contrarian": 1, "synthesist": 1,
    "conservative-operator": 1,
    "pragmatist": -1, "minimalist": -1, "archivist": -1,
    "explorer": 0, "empiricist": 0, "systems-thinker": 0, "optimizer": 0, "user-advocate": 0,
    "teacher": 0, "futurist": 0, "mediator": 0
  },
  "effort_ceiling": "xhigh",
  "teams": {
    "Feature Delivery": [["backend-engineer"], ["frontend-engineer"], ["test-engineer"]],
    "Bug Clinic": [["debugger", "detective"], ["test-engineer", "skeptic"]],
    "Service Readiness": [["reliability-engineer"], ["security-reviewer"], ["performance-engineer"]],
    "Data Trust": [["data-quality-auditor"], ["data-engineer"], ["statistician"]],
    "ML Validation": [["validation-auditor", "skeptic"], ["ml-engineer", "pragmatist"], ["statistician"]],
    "Research Synthesis": [["literature-reviewer"], ["peer-reviewer"], ["scientific-writer"]],
    "Mechanics Review": [["fem-specialist"], ["constitutive-modeler"], ["experimental-design-specialist"]],
    "Printability Lab": [["additive-manufacturing-specialist"], ["rheology-specialist"], ["validation-auditor"]],
    "Network Resilience": [["transport-network-analyst"], ["geospatial-analyst"], ["uncertainty-analyst"]],
    "Paper Revision": [["peer-reviewer", "skeptic"], ["scientific-writer"], ["visualization-specialist"]],
    "Teach and Explain": [["instructional-designer", "teacher"], ["visualization-specialist"], ["challenger"]],
    "Decision Room": [["decision-analyst"], ["cost-analyst"], ["scenario-planner"]]
  }
}
