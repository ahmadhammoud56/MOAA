diff -ruN a/scripts/text2png.py b/scripts/text2png.py
--- a/scripts/text2png.py	1970-01-01 03:00:00.000000000 +0300
+++ b/scripts/text2png.py	2026-10-22 17:51:15.481443600 +0300
@@ -0,0 +1,44 @@
+"""Render monospace text (stdin) to a PNG: text2png.py OUT.png [BG_HEX] [FG_HEX]."""
+import sys
+from pathlib import Path
+from PIL import Image, ImageDraw, ImageFont
+
+FONTS = ["CascadiaMono.ttf", "consola.ttf", "DejaVuSansMono.ttf", "Menlo.ttc", "cour.ttf"]
+
+
+def load_font(size):
+    for name in FONTS:
+        try:
+            return ImageFont.truetype(name, size)
+        except OSError:
+            continue
+    return ImageFont.load_default()
+
+
+def main():
+    out = Path(sys.argv[1])
+    bg = sys.argv[2] if len(sys.argv) > 2 else "#1e1e2e"
+    fg = sys.argv[3] if len(sys.argv) > 3 else "#cdd6f4"
+    text = sys.stdin.buffer.read().decode("utf-8").rstrip("\n")
+    lines = text.split("\n")
+    if lines and lines[0].startswith("```"):
+        lines = lines[1:]
+    if lines and lines[-1].strip() == "```":
+        lines = lines[:-1]
+    font = load_font(28)
+    asc, desc = font.getmetrics()
+    line_h = asc + desc + 4
+    char_w = font.getlength("M")
+    pad = 32
+    w = int(max(len(l) for l in lines) * char_w + pad * 2)
+    h = int(len(lines) * line_h + pad * 2)
+    img = Image.new("RGB", (w, h), bg)
+    draw = ImageDraw.Draw(img)
+    for i, line in enumerate(lines):
+        draw.text((pad, pad + i * line_h), line, font=font, fill=fg)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    img.save(out)
+    print(out)
+
+
+main()
diff -ruN a/tests/moaa-png.test.tsx b/tests/moaa-png.test.tsx
--- a/tests/moaa-png.test.tsx	1970-01-01 03:00:00.000000000 +0300
+++ b/tests/moaa-png.test.tsx	2026-10-22 17:51:15.550284100 +0300
@@ -0,0 +1,23 @@
+import { expect, test } from 'claude-code/testing'
+
+import { clipboardEnv, startSession } from './clipboard-env'
+
+const mount = {
+  plugin: 'prismantis',
+  component: 'AssistantMessage' as const,
+  props: { text: '| a | b |\n|---|---|\n| 1 | 2 |', isFirstOfReply: true },
+  viewport: { columns: 120, rows: 40 },
+  surface: 'terminal' as const,
+}
+
+for (const [env, shown] of [[{}, false], [{ PRISMANTIS_PNG_BUTTON: '1' }, true]] as const) {
+  test(`a table's ▣ png button is ${shown ? 'shown with' : 'hidden without'} PRISMANTIS_PNG_BUTTON`, async ($, on) => {
+    clipboardEnv(on, 'other', env)
+    await startSession($, on)
+    const ui = await $.ui.mount(mount)
+    const labels = (await ui.findAll({ type: 'Button' })).map(b => b.props.label)
+    expect(labels.includes('⧉ art')).toBe(true)
+    expect(labels.includes('▣ png')).toBe(shown)
+    await ui.unmount()
+  })
+}
