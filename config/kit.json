  "settings": {
    "env": {
      "ECC_GATEGUARD": "off"
    },
    "permissions_deny": [
      "Skill(lps:dogusariturk-python-style)"
    ],
    "defaults": {
      "model": "sonnet",
      "modelSettings": {
        "claude-sonnet-5": {
          "effortLevel": "high"
        }
      },
      "enableWorkflows": true,
      "skipWorkflowUsageWarning": true,
      "theme": "dark",
      "inputNeededNotifEnabled": true,
      "agentPushNotifEnabled": true
    }
  },
  "mcp": {
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.3.0",
        "mcp"
      ]
    },
    "ansys": {
      "repo": "https://github.com/vorobjewsen30-max/ansys-mcp-server.git",
      "commit": "36b18a94f2cd936e7566b348f21f0bc51c1b1f8b",
      "patch": "vendor/ansys-mcp-server.patch",
      "module": "ansys_mcp_server.server",
      "lock": "vendor/ansys-requirements.lock"
    }
  },
  "own_work": [
    "plugins/agent-arena-mode",
    "plugins/specialist-council",
    "plugins/war-room",
    "skills/agent-teams",
    "skills/local-build",
    "skills/path-safety",
    "agents/code-improver.md"
  ],
